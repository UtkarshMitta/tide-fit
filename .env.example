# --- Everything below is optional. TideFit runs with zero keys, degrading feature by feature. ---
# Condition data (Open-Meteo marine / weather / air quality) needs no key at all.

# Sponsor: Tavily — live web search grounding for real local spots and events
TAVILY_API_KEY=

# Sponsor: ElevenLabs — voice narration of each day's briefing
ELEVENLABS_API_KEY=
# Rachel by default; swap for any voice id from your ElevenLabs library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Sponsor: Stay22 — live accommodation listings with prices (server-side only).
# With this set, the trip page lists real bookable stays; without it TideFit
# falls back to a Tavily search across booking sites (names and links, no prices).
STAY22_API_KEY=

# Stay22 affiliate id for the map widget (public, appears in the iframe URL).
# Optional when STAY22_API_KEY is set: the aid is read back from the API response.
NEXT_PUBLIC_STAY22_AID=

# LLM used to write the itinerary. Without it TideFit uses a rule-based template.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: air quality via OpenWeatherMap instead of Open-Meteo
OPENWEATHER_API_KEY=

# Optional: Supabase auth + saved trips. Without it trips are kept in memory only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required once supabase/002_tighten_rls.sql is applied: with owner-only RLS,
# trip reads and writes run through the service role instead of the anon key.
# SERVER-SIDE ONLY — this key bypasses RLS, so it must never get a NEXT_PUBLIC_
# prefix or be committed. Find it in Supabase under Project Settings > API.
# Leave blank to stay on the original schema.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Google Calendar sync
# Authorised redirect URI: {APP_URL}/api/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional (stretch): Strava training load for all visitors.
# Leave blank to let each user paste their own Client ID + Secret in the UI.
# Authorization callback domain must match your app host.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Public base URL, used to build OAuth redirect URIs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stage panic switch: forces the canned Lisbon trip for every request
TIDEFIT_DEMO_MODE=false
