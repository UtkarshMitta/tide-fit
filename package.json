{
  "name": "tide-fit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "demo:audio": "tsx --env-file-if-exists=.env.local scripts/prerender-demo-audio.ts",
    "check:conditions": "tsx --env-file-if-exists=.env.local scripts/check-conditions.ts",
    "check:rls": "tsx --env-file-if-exists=.env.local scripts/check-rls.ts",
    "check:lodging": "tsx --env-file-if-exists=.env.local scripts/probe-lodging.ts",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.62.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@tavily/core": "^0.7.7",
    "clsx": "^2.1.1",
    "next": "16.3.5",
    "openai": "^4.104.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
